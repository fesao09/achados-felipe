  def carregar_dados(self):
    if os.path.exists(self.json_path):
      with open(self.json_path, 'r', encoding='utf-8') as f:
        return json.load(f)
    return []

  def classificar_produto(self, titulo_produto):
    titulo_lower = titulo_produto.lower()
    for categoria, palavras_chave in self.categorias_mapeadas.items():
      for termo in palavras_chave:
        if termo in titulo_lower:
          return categoria
    return 'Outros Achados'

  def obter_inteligencia_produto(self, titulo_produto):
    categoria = self.classificar_produto(titulo_produto)
    return self.inteligencias_nicho.get(
        categoria,
        {
            'publico_alvo': 'Público geral de achados da Shopee.',
            'gatilho_mental': 'Custo-benefício e utilidade imediata.',
            'diretriz_copy': 'Focar na utilidade prática e preço atrativo.',
        },
    )

  def obter_estatisticas(self):
    total = len(self.base_dados)
    stats = {cat: 0 for cat in self.categorias_mapeadas.keys()}
    stats['Outros Achados'] = 0

    for item in self.base_dados:
      cat = self.classificar_produto(item.get('title', ''))
      stats[cat] += 1

    return total, stats


if __name__ == '__main__':
  cerebro = CerebroAchadosFelipeV3Completo()
  total, stats = cerebro.obter_estatisticas()
  print(f'=== CÉREBRO V3 COMPLETO - STATUS ({total} itens analisados) ===')
  for cat, qtd in stats.items():
    print(f'- {cat}: {qtd} produtos mapeados')
